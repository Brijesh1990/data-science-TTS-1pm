    "# update dictionary items via update()\n",
    "student={\"name\":\"brijesh\",\"age\":34,\"department\":\"IT\"}\n",
    "student[\"name\"]=\"devanshu\"\n",
    "student[\"age\"]=28\n",
    "student.update({\"name\":\"devanshu\",\"age\":28,\"department\":\"CSE\"})\n",
    "print(student)"
